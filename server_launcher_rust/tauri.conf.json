{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Launcher",
  "version": "0.1.0",
  "identifier": "com.serverlauncher.android-cockpit",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "adb-cockpit",
        "title": "DroidM",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["assets/icon.png"],
    "linux": {
      "deb": {
        "depends": ["curl", "python3", "pkexec"],
        "files": {
          "/usr/libexec/server-launcher-sensors": "packaging/server-launcher-sensors",
          "/usr/share/polkit-1/actions/com.serverlauncher.sensors.policy": "packaging/com.serverlauncher.sensors.policy"
        }
      },
      "rpm": {
        "depends": ["curl", "python3", "polkit"],
        "files": {
          "/usr/libexec/server-launcher-sensors": "packaging/server-launcher-sensors",
          "/usr/share/polkit-1/actions/com.serverlauncher.sensors.policy": "packaging/com.serverlauncher.sensors.policy"
        }
      }
    }
  }
}
