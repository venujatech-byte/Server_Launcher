{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Launcher",
  "version": "0.1.0",
  "identifier": "com.serverlauncher.app",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Server Launcher",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "assets/icon.png"
    ]
  }
}